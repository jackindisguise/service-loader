{
	"name": "service-loader",
	"version": "1.0.0",
	"description": "",
	"main": "./dist/cjs/service.js",
	"module": "./dist/esm/service.js",
	"types": "./dist/esm/service.d.ts",
	"exports": {
		".": {
			"types": "./dist/esm/service.d.ts",
			"import": "./dist/esm/service.js",
			"require": "./dist/cjs/service.js"
		}
	},
	"scripts": {
		"build:esm": "tsc",
		"build:cjs": "npx babel dist/esm --out-dir dist/cjs --plugins @babel/plugin-transform-modules-commonjs --copy-files",
		"build": "npm run build:esm && npm run build:cjs",
		"test": "npm run build && node --test test/service.test.cjs"
	},
	"keywords": [
		"service",
		"service loader",
		"package",
		"package loader"
	],
	"author": "jackindisguise",
	"license": "ISC",
	"dependencies": {
		"@types/node": "^25.6.2",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.6",
		"@babel/core": "^7.29.0",
		"@babel/plugin-transform-modules-commonjs": "^7.28.6"
	}
}
